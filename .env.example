# Optional. When absent, .data/signbridge.json provides durable SINGLE-PROCESS local storage.
DATABASE_URL=
# Set a strong random 32+ character secret before any public deployment.
SESSION_SECRET=
# Production refuses guest-demo writes unless this is explicitly true.
ALLOW_DEMO_MODE=false
# Optional same-origin path to a compatible licensed GLB/GLTF. Empty = procedural test rig.
NEXT_PUBLIC_AVATAR_URL=
# Optional local storage directory (default .data). Do not place in public/.
LOCAL_DATA_DIR=.data
# Recommended behind a production reverse proxy; exact browser origin, no trailing slash.
APP_ORIGIN=
# Optional REAL English-to-ISL motion model, not a generic chat/LLM endpoint.
# Empty = use an installed local research decoder in development, otherwise reference previews only.
# HTTPS or local loopback HTTP only. See docs/isl-model.md for the response contract.
ISL_MODEL_URL=
# Optional server-only bearer token. Never use NEXT_PUBLIC_ for credentials.
ISL_MODEL_TOKEN=
# Development-only local SignVQVAE decoder; set 0 to disable. Disabled in production regardless.
# Run pnpm isl:setup once; pnpm dev starts installed local services. No commercial asset rights are established.
ISL_LOCAL_RESEARCH=1
# Required before both ISL and ASL conversion. The portable local server listens on port 8081.
# This endpoint does not generate ISL motion. See docs/genai.md.
PARAPHRASE_MODEL_URL=http://127.0.0.1:8081/v1
PARAPHRASE_MODEL_NAME=signbridge-qwen2.5-1.5b
# Optional server-only token for your own compatible model service.
PARAPHRASE_MODEL_TOKEN=
